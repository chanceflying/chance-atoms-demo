# Optional. Public anonymous demos should keep this empty unless rate limiting
# and a model budget are configured. The key is read server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional for local GitHub sign-in. Register the callback URL as
# http://localhost:3000/api/auth/github/callback for local development.
# Store production values with `wrangler secret put`; never commit them.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
