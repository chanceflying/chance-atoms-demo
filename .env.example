# Optional. Public anonymous demos should keep this empty unless rate limiting
# and a model budget are configured. The key is read server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional. Keep empty for the browser-only local Bridge flow. Set a strong,
# random value when the Bridge is reached through an HTTPS tunnel.
CODEX_BRIDGE_TOKEN=
CODEX_BRIDGE_PORT=4317

# Optional server-side Codex subscription fallback. Configure both values on
# the Worker. The token must match CODEX_BRIDGE_TOKEN on the Mac Bridge.
REMOTE_CODEX_BRIDGE_URL=
REMOTE_CODEX_BRIDGE_TOKEN=
# Required for the temporary localhost.run interview route. Encrypts request
# and response payloads end-to-end with a key derived from the shared token.
REMOTE_CODEX_BRIDGE_E2EE=1

# Optional for local GitHub sign-in. Register the callback URL as
# http://localhost:3000/api/auth/github/callback for local development.
# Store production values with `wrangler secret put`; never commit them.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
