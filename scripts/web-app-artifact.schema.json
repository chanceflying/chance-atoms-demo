{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chance Atoms Web App Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "title",
    "description",
    "html",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "web_app"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "html": {
      "type": "string",
      "minLength": 32,
      "maxLength": 300000
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
