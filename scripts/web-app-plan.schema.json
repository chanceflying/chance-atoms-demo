{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chance Atoms Web App Plan Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan", "reasoningSummary"],
  "properties": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "title",
        "requestSummary",
        "designDecisions",
        "interactionFlow",
        "implementationSteps",
        "assumptions",
        "acceptanceCriteria"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "web_app_plan"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "requestSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "designDecisions": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "interactionFlow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "implementationSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "reasoningSummary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  }
}
